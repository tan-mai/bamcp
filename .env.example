# Copy thanh .env roi dien. KHONG commit file .env.
#   cp .env.example .env
#   openssl rand -base64 24        # sinh password
BAMCP_USERNAME=bamcp
BAMCP_PASSWORD=

# Domain that + dang :* cho moi port. Ngan cach bang dau phay.
BAMCP_ALLOWED_HOSTS=btc.example.com,btc.example.com:*,127.0.0.1:*,localhost:*

BAMCP_SYMBOL=BTCUSDT
BAMCP_MARKET=futures
TZ=Asia/Ho_Chi_Minh

# --- Doc tai khoan san (tuy chon) ---
# Bat account.enabled: true trong config.yaml roi dien ba dong duoi.
# Key PHAI la read-only: tat quyen trade, tat quyen rut tien, bat IP whitelist cua VPS.
BAMCP_EXCHANGE=okx
BAMCP_EXCHANGE_KEY=
BAMCP_EXCHANGE_SECRET=
# Chi OKX moi can passphrase
BAMCP_EXCHANGE_PASSPHRASE=

# --- LUU Y ---
# Tu khi co trang admin (/admin), cac bien BAMCP_USERNAME, BAMCP_PASSWORD va
# BAMCP_EXCHANGE_* chi con la GIA TRI KHOI TAO cho lan chay dau tien.
# Sau khi ban bam Luu tren trang do, nguon su that la data/settings.json,
# va sua cac bien duoi day se khong con tac dung nua.
